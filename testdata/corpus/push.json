[
  {
    "name": "explicit",
    "argv": [
      "push",
      "origin",
      "HEAD:refs/heads/main"
    ],
    "want": {
      "operations": [
        {
          "action": "remote.push.update",
          "effect": "write",
          "coverage": "semantic",
          "parameters": {
            "forceMode": "none",
            "leaseMode": "none"
          },
          "target": {
            "refs": {
              "kind": "exact",
              "values": [
                "refs/heads/main"
              ],
              "complete": true
            },
            "remote": "origin"
          }
        }
      ]
    }
  },
  {
    "name": "force",
    "argv": [
      "push",
      "--force",
      "origin",
      "main"
    ],
    "want": {
      "operations": [
        {
          "action": "remote.push.update",
          "effect": "write",
          "coverage": "semantic",
          "parameters": {
            "forceMode": "unconditional"
          }
        }
      ]
    }
  },
  {
    "name": "plus",
    "argv": [
