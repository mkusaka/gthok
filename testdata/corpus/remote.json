      "origin"
    ],
    "want": {
      "operations": [
        {
          "action": "remote.fetch",
          "effect": "write",
          "coverage": "semantic",
          "parameters": {
            "writeFetchHead": false,
            "unshallow": true
          }
        }
      ]
    }
  },
