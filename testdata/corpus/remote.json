[
  {
    "name": "fetch",
    "argv": [
      "fetch",
      "origin",
      "+refs/heads/main:refs/remotes/origin/main"
    ],
    "want": {
      "operations": [
        {
          "action": "remote.fetch",
          "effect": "write",
          "coverage": "semantic",
          "scopes": [
            "local-ref",
            "objects"
          ],
          "parameters": {
            "writeFetchHead": true
          }
        }
      ]
    }
  },
  {
    "name": "fetch-all",
    "argv": [
      "fetch",
      "--all",
      "--prune",
      "--prune-tags",
      "--depth=2"
    ],
    "want": {
      "operations": [
        {
          "action": "remote.fetch",
          "effect": "write",
          "coverage": "semantic",
          "parameters": {
            "all": true,
            "prune": true,
            "pruneTags": true,
            "depth": "2"
          }
        }
      ]
    }
  },
  {
    "name": "fetch-preview",
    "argv": [
      "fetch",
      "--dry-run",
      "origin"
    ],
    "want": {
      "operations": [
        {
          "action": "remote.fetch",
          "effect": "read",
          "coverage": "semantic",
          "parameters": {
            "dryRun": true,
            "writeFetchHead": false
          }
        }
      ]
    }
  },
  {
    "name": "fetch-no-head",
    "argv": [
      "fetch",
      "--no-write-fetch-head",
