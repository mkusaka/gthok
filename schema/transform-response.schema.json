{
  "$id": "https://raw.githubusercontent.com/mkusaka/gthok/main/schema/transform-response.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "env": {
      "additionalProperties": {
        "oneOf": [
          {
            "pattern": "^[^\\x00]*$",
            "type": "string"
          },
          {
            "type": "null"
          }
        ]
      },
      "description": "Environment edits; string values set variables and null unsets them.",
      "propertyNames": {
        "not": {
          "pattern": "^(GTHOK_.*|GIT_.*|DYLD_.*|XDG_CONFIG_HOME|HOME|PATH|LD_PRELOAD|LD_LIBRARY_PATH)$"
        },
        "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
      },
      "type": "object"
    },
    "schemaVersion": {
      "const": 1,
      "type": "integer"
    },
    "set": {
      "additionalProperties": {},
      "propertyNames": {
        "pattern": "^/operations/(0|[1-9][0-9]*)/(texts/(title|body|notes)/value|parameters/([^/~]|~[01])+|target/remote)$"
      },
      "type": "object"
    },
    "unset": {
      "items": {
        "pattern": "^/operations/(0|[1-9][0-9]*)/(texts/(title|body|notes)/value|parameters/([^/~]|~[01])+|target/remote)$",
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "warning": {
      "type": "string"
    }
  },
  "required": [
    "schemaVersion"
  ],
  "title": "gthok transform response",
  "type": "object"
}
